#!/bin/sh
# Runs inside the access point's own network namespace. See `ap`.
set -u
name=$1 iface=$2 ssid=$3 psk=$4 channel=$5 net=$6
run=/var/run/ap-$name
touch "$run/ready"

# Wait for the radio to arrive in this namespace.
i=0
until ifconfig "$iface" >/dev/null 2>&1; do
    sleep 1
    i=$((i + 1))
    [ "$i" -lt 30 ] || { echo "$iface never arrived"; exit 1; }
done
ifconfig lo 127.0.0.1 up
ifconfig "$iface" "$net.1" netmask 255.255.255.0 up

cat > "$run/hostapd.conf" <<CONF
interface=$iface
driver=nl80211
ctrl_interface=$run/hostapd
ssid=$ssid
hw_mode=g
channel=$channel
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=$psk
CONF

cat > "$run/udhcpd.conf" <<CONF
start $net.100
end $net.150
interface $iface
lease_file $run/leases
pidfile $run/udhcpd.pid
option subnet 255.255.255.0
option router $net.1
option lease 600
CONF
touch "$run/leases"
udhcpd "$run/udhcpd.conf"

while :; do
    read -r cmd < "$run/ctl"
    case "$cmd" in
        up)
            if ! { [ -f "$run/hostapd.pid" ] && kill -0 "$(cat "$run/hostapd.pid")" 2>/dev/null; }; then
                hostapd -B -P "$run/hostapd.pid" "$run/hostapd.conf"
            fi
            ;;
        down)
            [ -f "$run/hostapd.pid" ] && kill "$(cat "$run/hostapd.pid")" 2>/dev/null
            rm -f "$run/hostapd.pid"
            ;;
    esac
    touch "$run/ack"
done
